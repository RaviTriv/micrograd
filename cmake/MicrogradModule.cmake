function(micrograd_module name)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "DEPS")
    add_library(micrograd_${name} INTERFACE)
    add_library(micrograd::${name} ALIAS micrograd_${name})
    target_link_libraries(micrograd_${name} INTERFACE micrograd::options ${arg_DEPS})
endfunction()

function(micrograd_test name)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "SOURCES;DEPS")
    if(NOT MICROGRAD_BUILD_TESTS)
        return()
    endif()
    add_executable(${name} ${arg_SOURCES})
    target_link_libraries(${name} PRIVATE micrograd::options ${arg_DEPS} GTest::gtest_main)
    gtest_discover_tests(${name} DISCOVERY_MODE PRE_TEST)
endfunction()
